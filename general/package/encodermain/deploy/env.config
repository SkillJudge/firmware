# ========================================================================
# encodermain/deploy/env.config
#   deploy 运行时参数（一次性填好，以后跑 run.sh 自动加载）。
#   ⚠ 此文件含明文密码：请执行 `git status` 前确认它被 .gitignore 忽略；
#   如果没忽略，不要提交到仓库。（deploy.sh 已经要求你在编译虚机执行，
#   因此这个文件只需要保存在你本地编译虚机里。）
# ========================================================================

# ---- build 环境 ----
# 编译虚机（192.168.0.104）上 git 仓库根路径：必须是包含 firmware/ 子目录的那个顶层目录。
# 如果不确定，进到编译虚机看哪个父目录下能 find firmware/Makefile → 那就是 GIT_DIR。
GIT_DIR=/home/skilljudge/work/encoder
FIRMWARE_BOARD=gk7205v300-nor-ultimate

# ---- 跳板机：公网 DMZ 58.198.176.157 ----
# （Environment.md 第 34 行 DMZ=58.198.176.157；
#   这里复用 公网服务器 123.60.51.11 的 root 凭据作为跳板。
#   若你另有跳板机账号，改下面两个变量即可。）
JUMP_HOST=58.198.176.157
JUMP_USER=skilljudge
JUMP_PASS='skilljudge12345'

# ---- 编码器 01 号 ----
# 说明：ENC_000001 对应 192.168.250.126。
# 如果你要部署到 00(116) / 02(125)，把 BOARD_IP 改一下即可。
BOARD_IP=192.168.250.126
BOARD_USER=root
BOARD_PASS='12345'

# ---- 可选（你通常不需要动） ----
# FIRMWARE_DIR=$GIT_DIR/firmware
# OUTPUT_DIR=$GIT_DIR/firmware/output
BOARD_DEPLOYDIR=/mnt/mmcblk0p1/encdeploy
