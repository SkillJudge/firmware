# 1. 动态获取当前 Makefile 所在的绝对路径
CURRENT_DIR := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

# 2. 自动向上寻找主目录路径（剔除 general/package 之后的尾巴）
TOP_DIR := $(shell echo "$(CURRENT_DIR)" | sed 's/\/general\/package.*//' | xargs)

# 3. 国科芯片 musl 交叉编译器前缀（与 factoryinit 同款）
CROSS_COMPILE = $(TOP_DIR)/output/host/bin/arm-openipc-linux-musleabi-
CC            = $(CROSS_COMPILE)gcc
STRIP         = $(CROSS_COMPILE)strip

TARGET   = encalertd
SRCS     := $(wildcard *.c)

all: $(TARGET)

$(TARGET): $(SRCS) common.h
	# _GNU_SOURCE 由各 .c 文件自行 #define，命令行重复定义会产生警告
	$(CC) -Os -Wall -std=c99 $(SRCS) -o $(TARGET)
	$(STRIP) $(TARGET)
	@echo "[OK] 本地独立交叉编译成功: $(TARGET)"
	@echo "     编译器: $(CC)"

clean:
	rm -f $(TARGET)
